# Copy to `manga_video_pipeline/.env` or repo root `.env` — never commit real API keys.
# See docs/COST_SAVINGS.md for a budget-oriented preset; this file is tuned for quality.

# --- API keys: prefer repo-root `manga_recitation/.env` (one level up from this folder). ---
# Avoid empty OPENAI_API_KEY= in this file if you also use root `.env` — empty values can win in merge order.
# OPENAI_API_KEY=
# ELEVENLABS_API_KEY=

# --- Core ---
ENABLE_CACHE=true
APP_ENV=development
LOG_LEVEL=INFO

# --- Best audio: TTS / ElevenLabs ---
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
# Higher bitrate = cleaner speech (larger cache files). Use mp3_44100_128 if your account rejects 192.
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_192
ELEVENLABS_TTS_HUMANIZE=true
ELEVENLABS_TTS_SPEECH_SPEED=0.97
ELEVENLABS_TTS_LINE_CONTEXT=true
ELEVENLABS_TTS_OPTIMIZE_STREAMING_LATENCY=0

# Scene music (when not using local BGM library only)
ELEVENLABS_MUSIC_MODEL_ID=music_v1
ELEVENLABS_MUSIC_OUTPUT_FORMAT=mp3_44100_192
ELEVENLABS_MUSIC_FORCE_INSTRUMENTAL=true

# --- Cinematic mix (narration + bed + SFX) ---
AUDIO_BED_IN_NARRATION=true
AUDIO_MIXER_VOICE_GAIN=1.0
AUDIO_MIXER_MUSIC_GAIN=0.16
AUDIO_MIXER_SFX_GAIN=0.7
AUDIO_MIXER_DUCKING_ENABLED=true
AUDIO_MIXER_DUCKING_THRESHOLD=0.05
AUDIO_MIXER_DUCKING_RATIO=12
AUDIO_MIXER_DUCKING_ATTACK_MS=50
AUDIO_MIXER_DUCKING_RELEASE_MS=400
AUDIO_MIXER_NORMALIZE_LOUDNESS=true
AUDIO_MIXER_USE_LOUDNORM=true
AUDIO_MIXER_HIGHPASS_HZ=80
AUDIO_MIXER_LOWPASS_HZ=12000
# Music stem only: clearer under voice; set to 0 to disable HPF on bed.
AUDIO_MIXER_MUSIC_HIGHPASS_HZ=100
AUDIO_MIXER_MUSIC_DYNAUDNORM_ENABLED=true

# Multi-scene episodes: smooth joins between scene MP3s (0 = plain concat).
# Timeline offsets are adjusted so subtitles / sync stay aligned.
AUDIO_SCENE_CROSSFADE_SEC=0.06

# --- Local BGM library (cost-saving; pair with ELEVENLABS_MUSIC_ENABLED=false) ---
BGM_LIBRARY_PREFER_LOCAL=true
BGM_LIBRARY_COUNT=10
# BGM_DEFAULT_PATH=/absolute/path/to/your_loop.mp3

# --- Video mux / panel concat (smoother encode + cleaner final audio) ---
DEFAULT_FPS=30
# Lower CRF = higher quality / larger files (typical 18–22 for YouTube).
VIDEO_CONCAT_CRF=19
VIDEO_CONCAT_PRESET=medium
VIDEO_MUX_AUDIO_BITRATE_K=192

# --- Panel framing / motion (YouTube 16:9 + Reel 9:16) ---
PANEL_SCREEN_FILL_RATIO=0.9
# Calmer vertical motion on Reels (1.0 = legacy; 0.7–0.9 = easier to read).
PANEL_REEL_MOTION_AMP_SCALE=0.85

# --- Cost knobs (raise OCR/dialogue quality or lower batch sizes as needed) ---
OPENAI_OCR_BATCH_SIZE=3
OPENAI_OCR_MAX_IMAGE_DIM=768
OPENAI_OCR_JPEG_QUALITY=72
OPENAI_DIALOGUE_BATCH_SIZE=6
# Rewrite OCR into spoken narration (social UI / hashtags); set false to save tokens.
OPENAI_NARRATION_POLISH_ENABLED=true
OPENAI_NARRATION_POLISH_BATCH_SIZE=8
NARRATION_POLISH_MAX_WORDS=22
NARRATION_POLISH_STYLE=literary_compact
OPENAI_EMOTION_REFINE_MAX_LINES=0

# ElevenLabs extras (disable to save credits)
ELEVENLABS_SFX_ENABLED=false
# false = local BGM library for scene beds (recommended with BGM_LIBRARY_PREFER_LOCAL=true)
ELEVENLABS_MUSIC_ENABLED=false

# --- Grouping (fewer TTS calls) ---
AUDIO_GROUPING_ENABLED=true
AUDIO_GROUP_MAX_CHARS=220
